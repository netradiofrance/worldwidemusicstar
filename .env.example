# ====================================================================
# WORLDWIDE MUSIC STAR — Environment variables
# Copy this file to .env.local for development.
# In production, set these in Vercel project settings -> Environment Variables.
# ====================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://worldwidemusicstar.com"
NEXT_PUBLIC_SITE_NAME="WorldWide Music Star"

# --- Supabase (database, storage, admin auth) ---
# Get these from https://app.supabase.com -> Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # SERVER ONLY — never expose

# --- Spotify Web API ---
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""

# --- Anthropic (Claude) — blog article generation ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- OpenAI — blog cover image generation (gpt-image-1) ---
OPENAI_API_KEY="sk-..."

# --- Mailjet — transactional email (subscribe, payment confirmation, etc.) ---
MAILJET_API_KEY=""
MAILJET_API_SECRET=""
MAILJET_FROM_EMAIL="noreply@worldwidemusicstar.com"
MAILJET_FROM_NAME="WorldWide Music Star"

# --- PayPal (current payment method) ---
# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"   # change to "live" when going live

# --- Stripe (placeholder — not active yet, will replace PayPal) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_ENABLED="false"

# --- Admin authentication ---
# Generate a strong random string: openssl rand -base64 32
ADMIN_JWT_SECRET=""
# Initial admin email — used by the seed script
ADMIN_EMAIL="admin@worldwidemusicstar.com"
ADMIN_PASSWORD=""   # set a strong one, then change after first login

# --- Cron / scheduled jobs security ---
# Required header value: x-cron-secret. Vercel cron will send this if configured.
CRON_SECRET=""

# --- Google Ad Manager VAST tag (vote popup ad) ---
NEXT_PUBLIC_VAST_TAG_URL="https://pubads.g.doubleclick.net/gampad/ads?iu=/23124331701,12626570/NetRadio/NetRadio-tackendo.com_Open-Video-Multi_Web-07Jan26&description_url=https%3A%2F%2Ftackendo.com%2F&tfcd=0&npa=0&sz=1x1%7C300x250%7C320x480%7C400x300%7C480x360%7C640x480&gdfp_req=1&unviewed_position_start=1&output=vast&env=vp&impl=s&plcmt=1&vpmute=0&vpa=auto&correlator=[timestamp]&hl=en"

# --- Pricing ---
# Must be NEXT_PUBLIC_ because the price is rendered client-side in the form.
NEXT_PUBLIC_ENTRY_PRICE_USD="99.99"
